#!/bin/sh
# StateCat launcher (optional, POSIX shells, including Git Bash).
# Forwards all arguments to statecat.py in the same directory as this
# launcher, so `./statecat check` works without typing python3.
# It tries python3, then py, then python, because on Windows python3
# is often a Microsoft Store stub that runs nothing.
for p in python3 py python; do
  if "$p" -c '' >/dev/null 2>&1; then
    exec "$p" "$(dirname "$0")/statecat.py" "$@"
  fi
done
echo "statecat: no working Python found (tried python3, py, python)" >&2
exit 127
